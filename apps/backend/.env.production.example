PORT=3001
NODE_ENV=production

# Cambiar antes de publicar. Generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_secret

# Dominios permitidos separados por coma.
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# PostgreSQL para produccion. En docker-compose.prod.yml el host interno es "postgres".
POSTGRES_DB=fuvex
POSTGRES_USER=fuvex
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://fuvex:replace_with_strong_database_password@postgres:5432/fuvex?schema=public

# Infoburo
INFOBURO_USER=replace_me
INFOBURO_PASS=replace_me

# Admin inicial del seed. Cambiar antes del primer despliegue.
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password

# Storage documental. "local" requiere volumen persistente; "s3" funciona con DigitalOcean Spaces.
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/storage/expedientes

# S3 / DigitalOcean Spaces (obligatorio cuando STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=replace_with_bucket_name
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_FORCE_PATH_STYLE=false
